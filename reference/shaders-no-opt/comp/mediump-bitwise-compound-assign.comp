#version 310 es
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer Input
{
    uvec2 inputs[];
} _21;

layout(binding = 1, std430) writeonly buffer Output
{
    uint outputs[];
} _89;

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    uint x = _21.inputs[idx].x;
    uint y = _21.inputs[idx].y;
    mediump uint a = x;
    a = a | y;
    a = a & y;
    a = a ^ y;
    mediump uint b = x;
    b = b | y;
    uint s = y & 7u;
    mediump uint d = x;
    d = d << s;
    d = d >> s;
    mediump uvec2 c = uvec2(x, 0u);
    c = c | uvec2(y);
    uint h = x;
    h |= y;
    h &= y;
    h ^= y;
    h = h << s;
    h = h >> s;
    _89.outputs[idx] = ((((a + b) + c.x) + c.y) + d) + h;
}

